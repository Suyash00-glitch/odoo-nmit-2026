# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/dayflow?sslmode=require"

# Server
PORT=5000
NODE_ENV=development

# JWT Secrets (generate with: openssl rand -hex 64)
JWT_ACCESS_SECRET="your-super-secret-access-token-key-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key-min-32-chars"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# SMTP Email (optional — app works without this for demo)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Dayflow HRMS <noreply@dayflow.dev>"
